{
  "name": "smallbiz-cms-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable 5-page business website template with a built-in admin panel (Next.js + Tailwind + Prisma/PostgreSQL).",
  "scripts": {
    "predev": "node scripts/bootstrap.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts --if-empty && next build",
    "start": "next start",
    "setup": "node scripts/bootstrap.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
